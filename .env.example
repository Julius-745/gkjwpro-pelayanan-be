# JWT Configuration
# CRITICAL: Generate a strong JWT secret with at least 64 characters
# Use one of these commands to generate:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#   openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_STRONG_64+_CHARACTER_SECRET"
JWT_EXPIRES_IN='1d'

# Admin User Configuration
ADMIN_USERNAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Database Configuration (your existing vars)
DATABASE_URL=""

# CORS Configuration (your existing vars)
CORS_ORIGIN=http://localhost:3001,http://localhost:3001
# OR
ALLOWED_ORIGINS=http://localhost:30001,http://localhost:3001

# Server Configuration
PORT=3000