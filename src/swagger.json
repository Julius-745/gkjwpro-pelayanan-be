{
  "openapi": "3.0.0",
  "info": {
    "title": "Pelayanan Scheduler API",
    "description": "API for managing church service scheduling including users, positions, categories, and worship services",
    "version": "1.0.0",
    "contact": {
      "name": "API Support"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AuthUser": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "username": { "type": "string", "example": "john_doe" },
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "role": { "type": "string", "enum": ["admin", "user"], "example": "user" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 3, "example": "john_doe" },
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "password": { "type": "string", "minLength": 6, "example": "securepassword" },
          "role": { "type": "string", "enum": ["admin", "user"], "example": "user", "default": "user" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "john_doe" },
          "password": { "type": "string", "example": "securepassword" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
          "user": { "$ref": "#/components/schemas/AuthUser" },
          "message": { "type": "string", "example": "Login successful" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "John Doe" },
          "id_krw": { "type": "integer", "example": 1 },
          "id_category": { "type": "integer", "example": 1 },
          "id_pelayanLevel": { "type": "integer", "example": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "krw_name": { "type": "string", "example": "KRW Jakarta" },
          "categoryName": { "type": "string", "example": "Musik" },
          "levelName": { "type": "string", "example": "Senior" }
        }
      },
      "CreateUser": {
        "type": "object",
        "required": ["name", "id_krw", "id_category", "id_pelayanLevel"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "example": "John Doe" },
          "id_krw": { "type": "integer", "minimum": 1, "example": 1 },
          "id_category": { "type": "integer", "minimum": 1, "example": 1 },
          "id_pelayanLevel": { "type": "integer", "minimum": 1, "example": 1 }
        }
      },
      "UpdateUser": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "example": "John Doe" },
          "id_krw": { "type": "integer", "minimum": 1, "example": 1 },
          "id_category": { "type": "integer", "minimum": 1, "example": 1 },
          "id_pelayanLevel": { "type": "integer", "minimum": 1, "example": 1 }
        }
      },
      "IbadahCategory": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "categoryName": { "type": "string", "example": "Musik" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateIbadahCategory": {
        "type": "object",
        "required": ["categoryName"],
        "properties": {
          "categoryName": { "type": "string", "minLength": 1, "example": "Musik" }
        }
      },
      "KRW": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "krw_name": { "type": "string", "example": "KRW Jakarta" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateKRW": {
        "type": "object",
        "required": ["krw_name"],
        "properties": {
          "krw_name": { "type": "string", "minLength": 1, "example": "KRW Jakarta" }
        }
      },
      "PelayanLevel": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "levelName": { "type": "string", "example": "Senior" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreatePelayanLevel": {
        "type": "object",
        "required": ["levelName"],
        "properties": {
          "levelName": { "type": "string", "minLength": 1, "example": "Senior" }
        }
      },
      "PelayanPosition": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Worship Leader" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreatePelayanPosition": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "example": "Worship Leader" }
        }
      },
      "Ibadahs": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "id_users": { "type": "integer", "example": 1 },
          "id_ibadahCategory": { "type": "integer", "example": 1 },
          "id_pelayanPosition": { "type": "integer", "example": 1 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "userName": { "type": "string", "example": "John Doe" },
          "categoryName": { "type": "string", "example": "Musik" },
          "positionName": { "type": "string", "example": "Worship Leader" },
          "krw_name": { "type": "string", "example": "KRW Jakarta" },
          "levelName": { "type": "string", "example": "Senior" }
        }
      },
      "CreateIbadah": {
        "type": "object",
        "required": ["id_users", "id_ibadahCategory", "id_pelayanPosition"],
        "properties": {
          "id_users": { "type": "integer", "minimum": 1, "example": 1 },
          "id_ibadahCategory": { "type": "integer", "minimum": 1, "example": 1 },
          "id_pelayanPosition": { "type": "integer", "minimum": 1, "example": 1 }
        }
      },
      "UpdateIbadah": {
        "type": "object",
        "properties": {
          "id_users": { "type": "integer", "minimum": 1, "example": 1 },
          "id_ibadahCategory": { "type": "integer", "minimum": 1, "example": 1 },
          "id_pelayanPosition": { "type": "integer", "minimum": 1, "example": 1 }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "type": "object" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string", "example": "Error message" }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": { "type": "string" },
                "expected": { "type": "string" },
                "received": { "type": "string" },
                "path": { "type": "array", "items": { "type": "string" } },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Check if the API is running",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "version": { "type": "string", "example": "1.0.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth":{
      "post": {
        "summary": "Authentication",
        "description": "Auth users",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthUser" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Authentication Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/AuthUser" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error or referenced record not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "Get all users",
        "description": "Retrieve all users with their related data",
        "tags": ["Users"],
        "responses": {
          "200": {
            "description": "List of users",
